{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev Flavor",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "args": [
        "--flavor",
        "dev"
      ]
    },
    {
      "name": "Prod Flavor",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_prod.dart",
      "args": [
        "--flavor",
        "prod"
      ]
    },
    {
      "name": "Dev Flavor (Profile Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "args": [
        "--flavor",
        "dev",
        "--profile"
      ],
      "flutterMode": "profile"
    },
    {
      "name": "Prod Flavor (Profile Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_prod.dart",
      "args": [
        "--flavor",
        "prod",
        "--profile"
      ],
      "flutterMode": "profile"
    },
    {
      "name": "Dev Flavor (Release Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "args": [
        "--flavor",
        "dev",
        "--release"
      ],
      "flutterMode": "release"
    },
    {
      "name": "Prod Flavor (Release Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_prod.dart",
      "args": [
        "--flavor",
        "prod",
        "--release"
      ],
      "flutterMode": "release"
    },
    {
      "name": "Web (Chrome) - Dev",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_web.dart",
      "args": [
        "-d",
        "chrome",
        "--dart-define-from-file=.env.web.local",
        "--web-header=Cross-Origin-Opener-Policy=same-origin",
        "--web-header=Cross-Origin-Embedder-Policy=require-corp"
      ]
    },
    {
      "name": "Web (Chrome) - Prod",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_web.dart",
      "args": [
        "-d",
        "chrome",
        "--dart-define-from-file=.env.web.prod.local",
        "--web-header=Cross-Origin-Opener-Policy=same-origin",
        "--web-header=Cross-Origin-Embedder-Policy=require-corp"
      ]
    },
    {
      "name": "Web Server (localhost:8080) - Dev",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_web.dart",
      "args": [
        "-d",
        "web-server",
        "--web-port",
        "8080",
        "--dart-define-from-file=.env.web.local",
        "--web-header=Cross-Origin-Opener-Policy=same-origin",
        "--web-header=Cross-Origin-Embedder-Policy=require-corp"
      ]
    }
  ]
}
