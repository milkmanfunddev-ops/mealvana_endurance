# Uncomment this line to define a global platform for your project
platform :ios, '16.6'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
  target 'RunnerUITests' do
    inherit! :complete
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Patrol: add PATROL_ENABLED Swift flag so the patrol pod compiles its
    # native automator code (otherwise it ships as a no-op).
    if target.name == 'patrol'
      target.build_configurations.each do |config|
        config.build_settings['OTHER_SWIFT_FLAGS'] ||= '$(inherited)'
        config.build_settings['OTHER_SWIFT_FLAGS'] += ' -D PATROL_ENABLED'
      end
    end
  end

  # Apple's App Store IPA validator rejects builds that bundle
  # patrol.framework because Patrol's native plugin references the private
  # `terminate` selector. Patrol is only needed inside the RunnerUITests
  # target (it drives UI automation during integration tests), so we strip
  # it out of the main Runner target's xcconfigs + embed-frameworks script
  # after pod install runs. RunnerUITests keeps its own
  # Pods-Runner-RunnerUITests xcconfigs untouched, so `patrol test`
  # continues to work.
  pods_runner_dir = File.join(__dir__, 'Pods', 'Target Support Files', 'Pods-Runner')

  Dir.glob(File.join(pods_runner_dir, 'Pods-Runner.*.xcconfig')).each do |file|
    original = File.read(file)
    cleaned = original
      .gsub(/\s+-framework\s+"patrol"/, '')
      .gsub(/\s+"\$\{PODS_CONFIGURATION_BUILD_DIR\}\/patrol"/, '')
      .gsub(/\s+"\$\{PODS_CONFIGURATION_BUILD_DIR\}\/patrol\/[^"]+"/, '')
      .gsub(/\s+"-F\$\{PODS_CONFIGURATION_BUILD_DIR\}\/patrol"/, '')
    if cleaned != original
      File.write(file, cleaned)
      puts "[Podfile] Stripped patrol from #{File.basename(file)}"
    end
  end

  frameworks_script = File.join(pods_runner_dir, 'Pods-Runner-frameworks.sh')
  if File.exist?(frameworks_script)
    original = File.read(frameworks_script)
    cleaned = original.gsub(/^\s*install_framework\s+"[^"]*patrol\.framework"\s*\n/, '')
    if cleaned != original
      File.write(frameworks_script, cleaned)
      puts "[Podfile] Removed patrol.framework install step from Pods-Runner-frameworks.sh"
    end
  end
end
