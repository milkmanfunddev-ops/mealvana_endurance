# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Script data files (large exports, not for version control)
scripts/data/

# Patrol auto-generated bundle (regenerated on every `patrol test` run)
patrol_test/

# Local scratch — never source-controlled
tmp/
output/
.venv_pptx/
__pycache__/

# Environment variables (NEVER commit these!)
.env
.env.*
.env.local
.env.*.local
.env.dev
.env.dev.local
.env.prod
.env.prod.local
.env.test
.env.test_supabase
!.env.example
!.env.web.example

# Dart defines for web builds (contains secrets - NEVER commit!)
.dart_defines.json
!.dart_defines.json.example

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing and Firebase (sensitive - never commit!)
android/key.properties
android/app/google-services.json

sentry.properties

# iOS CocoaPods
ios/Pods/
ios/Podfile.lock

# Node.js/NPM related
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tgz
.npm
.eslintcache

# Supabase CLI scratch state (project-ref, version pins) — env-specific,
# rewritten by `supabase link` etc. and should not be source-controlled.
supabase/.temp/

# Archived edge-fn test shim (kept for history)
_archived/test/local_edge_functions/node_modules/
_archived/test/local_edge_functions/.env*

# Secrets and API keys (never commit!)
secrets/
*.p8
*.p12
*.mobileprovision

# Tool cache files (contain tokens)
tool/.final_surge_token.json
tool/.training_peaks_token.json
.vercel
.env*.local

# Claude Code
.claude/
CLAUDE.md

# Patrol regenerates this on every `patrol test` run and the file itself
# says "DO NOT COMMIT TO VERSION CONTROL". Tracking it means every local or CI
# Patrol run leaves the tree dirty.
integration_test/test_bundle.dart

# Benchmark derived image variants — regenerable from images/ via run_benchmark.py.
# The JSON results ARE kept: they are the evidence behind the Notion report.
benchmarks/*/_derived/compressed/
benchmarks/*/_derived/uncompressed/

# git merge artifacts — never commit these
*.orig
*.rej

# Flutter golden-test diff artifacts (written on failure, never source)
**/test/**/failures/
