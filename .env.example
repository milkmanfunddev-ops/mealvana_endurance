# Mealvana Endurance — environment template
#
# Copy to `.env.dev.local` (dev flavor) or `.env.prod.local` (prod flavor).
# Every key is read by `AppConfig.fromEnv()` (lib/shared/services/app_config.dart)
# — that file is the source of truth for fallbacks; this template documents
# the flags that decide what a build SHOWS. Web builds use --dart-define
# (see .env.web.example).
#
# CI: Codemagic writes these files from the DOTENV_DEV_LOCAL / DOTENV_PROD_LOCAL
# secrets and force-sets the dev flags below (codemagic.yaml, "forced dev
# flavor"); prod builds fail if a required key is missing.

APP_ENVIRONMENT=dev            # dev | prod — everything else hangs off this
DEV_MODE_ENABLED=true

# ── Backend ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SENTRY_DSN=
MIXPANEL_PROJECT_TOKEN=
ONESIGNAL_APP_ID=
USDA_API_KEY=

# ── RevenueCat ─────────────────────────────────────────────────────────────
REVENUECAT_API_KEY_APPLE=appl_...     # the RC app whose bundle id matches the build
REVENUECAT_API_KEY_GOOGLE=goog_...
REVENUECAT_API_KEY_TEST=              # test_… — DEBUG dev builds only; never in prod

# ── Feature flags ──────────────────────────────────────────────────────────
# AI surfaces: default ON for dev, OFF for prod unless set.
AI_CREDITS_ENABLED=true
COACH_INSIGHTS_ENABLED=true
# DESCRIBE_MEAL_ENABLED is pinned open in code (2026-08-10); the key is inert.

# Pro subscription gate (meal planning is Pro-only — docs/implement_mealplanning/04-entitlement.md).
#   true  = /food/* and /vana/* require an active Pro entitlement (prod default)
#   false = everyone sees them (dev default; Codemagic forces this on dev builds)
# Prod builds MUST state this key explicitly — codemagic.yaml fails otherwise.
PRO_GATE_ENABLED=false
# Live Buy buttons on the /pro screen. Off everywhere until the paywall is
# submitted with an App Review screenshot; Restore works regardless.
PRO_PURCHASE_ENABLED=false

# ── Training integrations ──────────────────────────────────────────────────
TRAININGPEAKS_CLIENT_ID=mealvana
TRAININGPEAKS_CLIENT_SECRET=
TRAININGPEAKS_USE_SANDBOX=true
FINAL_SURGE_CLIENT_ID=
FINAL_SURGE_CLIENT_SECRET=
FINAL_SURGE_BASE_URL=https://log.finalsurge.com
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
VDOT_CLIENT_ID=mealvana
VDOT_CLIENT_SECRET=
VDOT_USE_SANDBOX=true

# ── Analytics ──────────────────────────────────────────────────────────────
ANALYTICS_DEV_ENABLED=false           # send real events from a dev build to the dev Mixpanel project
