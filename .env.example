# Mealvana Endurance — environment template
#
# Copy to `.env.dev.local` (dev flavor) or `.env.prod.local` (prod flavor).
# Runtime keys are read by `AppConfig.fromEnv()`
# (lib/shared/services/app_config.dart); planned integrations may be documented
# here before their code wiring lands. AppConfig is the source of truth for
# active fallbacks. Web builds use --dart-define (see .env.web.example).
#
# CI: Codemagic writes these files from the DOTENV_DEV_LOCAL / DOTENV_PROD_LOCAL
# secrets and force-sets the dev flags below (codemagic.yaml, "forced dev
# flavor"); prod builds fail if a required key is missing.

APP_ENVIRONMENT=dev            # dev | prod — everything else hangs off this
DEV_MODE_ENABLED=true

# ── Backend ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SENTRY_DSN=
MIXPANEL_PROJECT_TOKEN=
ONESIGNAL_APP_ID=
USDA_API_KEY=

# ── RevenueCat ─────────────────────────────────────────────────────────────
REVENUECAT_API_KEY_APPLE=appl_...     # the RC app whose bundle id matches the build
REVENUECAT_API_KEY_GOOGLE=goog_...
REVENUECAT_API_KEY_TEST=              # test_… — DEBUG dev builds only; never in prod

# ── Feature flags ──────────────────────────────────────────────────────────
# AI surfaces: default ON for dev, OFF for prod unless set.
AI_CREDITS_ENABLED=true
COACH_INSIGHTS_ENABLED=true
# DESCRIBE_MEAL_ENABLED is pinned open in code (2026-08-10); the key is inert.

# There is no subscription gate flag. Every build gates the whole app on the
# RevenueCat entitlement (docs/implement_mealplanning/04-entitlement.md,
# ticket 19): an account without one meets the paywall.

# ── External integrations ──────────────────────────────────────────────────
TRAININGPEAKS_CLIENT_ID=mealvana
TRAININGPEAKS_CLIENT_SECRET=
TRAININGPEAKS_USE_SANDBOX=true
FINAL_SURGE_CLIENT_ID=
FINAL_SURGE_CLIENT_SECRET=
FINAL_SURGE_BASE_URL=https://log.finalsurge.com
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_REDIRECT_URI=
KROGER_CLIENT_ID=
# MUST stay blank in Flutter asset env files. Use secrets/kroger.env on the server.
KROGER_CLIENT_SECRET=
KROGER_BASE_URL=https://api-ce.kroger.com/v1
KROGER_OAUTH_URL=https://api-ce.kroger.com/v1/connect/oauth2/authorize
KROGER_TOKEN_URL=https://api-ce.kroger.com/v1/connect/oauth2/token
KROGER_REDIRECT_URI=com.milkman.mealvanaendurance://callback
KROGER_SCOPES=cart.basic:write profile.compact product.compact
KROGER_USE_CERTIFICATION=true
VDOT_CLIENT_ID=mealvana
VDOT_CLIENT_SECRET=
VDOT_USE_SANDBOX=true

# ── Analytics ──────────────────────────────────────────────────────────────
ANALYTICS_DEV_ENABLED=false           # send real events from a dev build to the dev Mixpanel project

# Stock-photo APIs for the meal image tile bank (scripts/meal-images/)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
