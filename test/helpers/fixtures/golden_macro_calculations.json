  "validation_notes": {
    "MET_formula": "For pace >= 4 mph: VO2 = 0.2 * speed_m_per_min + 3.5, MET = VO2 / 3.5",
    "gross_calories": "MET * 3.5 * weight_kg / 200.0 * duration_min",
    "net_calories": "1.0 * weight_kg * distance_km",
    "pre_run_carbs": "min(3.0, max(0.5, time_before_hours)) * weight_kg",
    "during_carbs_bands": {
      "0-1h": "0-30g/h",
      "1-2h": "30-45g/h",
      "2-3h": "45-60g/h",
      "3-4h": "60-75g/h",
      "4h+": "75-90g/h"
    },
    "gut_training_caps": {
      "low": "80g/h dual source, 60g/h glucose only",
      "moderate": "90g/h dual source",
      "high": "100g/h dual source, 65g/h glucose only"
    }
