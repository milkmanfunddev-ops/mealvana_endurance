{
  "timeline": {
    "match": [
      "Timeline",
      "Home shell",
      "Main tabs",
      "Home"
    ],
    "drive": [
      {
        "tap": "Timeline",
        "type": "Button"
      }
    ]
  },
  "launcher": {
    "match": [
      "Any screen with the launcher",
      "Vana launcher",
      "Launcher"
    ],
    "reuse": "docs/ssot/decisions/images/mealplanning/timeline-launcher.png",
    "note": "The dev wrench covers the launcher on the simulator, so a capture never shows it; the 09-13 picture does."
  },
  "settings": {
    "match": [
      "Settings"
    ],
    "drive": [
      {
        "tap": "Settings",
        "type": "Button"
      }
    ]
  },
  "calendar-sheet": {
    "match": [
      "Calendar sheet over the Plan tab",
      "Calendar sheet",
      "Calendar"
    ],
    "drive": [
      {
        "tap": "Today,",
        "type": "Button"
      }
    ]
  },
  "plan-tab": {
    "match": [
      "Plan tab",
      "Food tab",
      "Food"
    ],
    "reuse": "test/features/meal_planning/presentation/goldens/plan_confirmed_light.png",
    "drive": [
      {
        "tap": "Food",
        "type": "Button"
      }
    ]
  },
  "meals-tab": {
    "match": [
      "Meals tab",
      "Meals"
    ],
    "drive": [
      {
        "tap": "Food",
        "type": "Button"
      },
      {
        "tap": "Meals"
      }
    ]
  },
  "shopping-tab": {
    "match": [
      "Shopping tab",
      "Shopping list",
      "Shopping"
    ],
    "reuse": "test/features/meal_planning/presentation/goldens/shopping_list_light.png",
    "drive": [
      {
        "tap": "Food",
        "type": "Button"
      },
      {
        "tap": "Shopping"
      }
    ]
  },
  "meal-detail": {
    "match": [
      "Meal detail",
      "Recipe detail",
      "Meal detail screen"
    ],
    "drive": [
      {
        "tap": "Food",
        "type": "Button"
      },
      {
        "tap": "Meals"
      },
      {
        "tapAfter": "RECENTS",
        "type": "GenericElement",
        "settle": 5000
      }
    ]
  },
  "cooking-mode": {
    "match": [
      "Cooking mode",
      "Cooking"
    ],
    "drive": [
      {
        "tap": "Food",
        "type": "Button"
      },
      {
        "tap": "Meals"
      },
      {
        "tapAfter": "RECENTS",
        "type": "GenericElement",
        "settle": 5000
      },
      {
        "tap": "Start cooking",
        "type": "Button"
      }
    ]
  },
  "vana-chat": {
    "match": [
      "Vana chat",
      "Vana chat after feedback",
      "Coach formula feedback",
      "Full-screen Vana chat",
      "Vana"
    ],
    "drive": [
      {
        "tap": "Food",
        "type": "Button"
      },
      {
        "tap": "Vana \u00b7",
        "settle": 3000
      }
    ]
  },
  "vana-sheet": {
    "match": [
      "Vana sheet",
      "Vana sheet open"
    ],
    "reuse": "test/features/meal_planning/presentation/goldens/vana_sheet_open_light.png"
  },
  "vana-sheet-moment": {
    "match": [
      "Vana sheet on a recovery moment",
      "Vana sheet on a moment",
      "Recovery moment"
    ],
    "reuse": "test/features/meal_planning/presentation/goldens/vana_sheet_moment_tinted_light.png"
  },
  "vana-conversations": {
    "match": [
      "Vana conversations",
      "Conversations"
    ],
    "drive": [
      {
        "tap": "Food",
        "type": "Button"
      },
      {
        "tap": "Vana \u00b7",
        "settle": 3000
      },
      {
        "tap": "Conversations"
      }
    ]
  },
  "paywall": {
    "match": [
      "Paywall",
      "Pro paywall",
      "Pro screen"
    ],
    "note": "Reached only through a Pro-required error or the Pro gate redirect; the dev account is Pro, so no drive gets there. Left unpictured until an account without Pro is on the simulator."
  }
}
