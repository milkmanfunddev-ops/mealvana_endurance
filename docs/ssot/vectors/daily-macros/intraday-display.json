    {
      "id": "tef-zero-before-first-meal",
      "status": "ratified",
      "kind": "so_far",
      "inputs": {
        "minutesSinceMidnight": 900,
        "rmr": 1908,
        "neatKcal": 378,
        "eatenKcal": 0,
        "sessions": [
