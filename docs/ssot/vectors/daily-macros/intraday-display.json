    {
      "id": "intake-remaining-logged-only",
      "status": "ratified",
      "kind": "intake",
      "inputs": {
        "targetKcal": 4152,
        "entries": [
          {
            "kcal": 640,
            "consumed": true
          },
          {
            "kcal": 330,
            "consumed": true
          },
          {
            "kcal": 680,
            "consumed": true
          },
          {
            "kcal": 470,
            "consumed": false
          },
          {
            "kcal": 600,
            "consumed": false
          }
        ]
      },
      "expected": {
        "logged": 1650,
        "planned": 1070,
        "remaining": 2502,
        "projected": 2720
      },
      "why": "Check 3: remaining = target - LOGGED (2502) \u2014 planned food reduces nothing until eaten. projected = logged+planned is copy-only."
