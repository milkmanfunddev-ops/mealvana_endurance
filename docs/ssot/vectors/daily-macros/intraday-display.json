      "expected": {
        "digestion": 0.0
      },
      "why": "Check 1b: digestion is exactly 0 before any intake \u2014 TEF is meal-driven, never clock-prorated."
    },
    {
      "id": "deleted-activity-contributes-zero",
      "status": "ratified",
      "kind": "so_far",
      "inputs": {
        "minutesSinceMidnight": 900,
        "rmr": 1908,
        "neatKcal": 394.9,
        "eatenKcal": 1650,
        "sessions": [
          {
            "kcal": 228.7,
            "actualTimeMin": 480,
            "status": "deleted"
          },
          {
            "kcal": 1205.3,
            "actualTimeMin": null
          }
        ]
      },
      "expected": {
        "workout": 0.0,
        "burned": 1554.95,
        "rendered": false
      },
      "why": "4b: a status=deleted activity contributes ZERO to every derived quantity and never renders \u2014 identical in effect to nonexistence. The row itself persists in Supabase (tombstone; sync matcher must still see it)."
    },
    {
      "id": "neat-connected-staleness-bridge",
      "status": "ratified",
      "kind": "so_far",
      "inputs": {
        "minutesSinceMidnight": 900,
        "rmr": 1908,
        "neatKcal": 394.9,
        "eatenKcal": 1650,
        "wearableConnected": true,
        "syncedToday": true,
        "lastSyncMin": 780,
        "activeEnergyThroughSync": 520,
        "sessions": [
          {
            "kcal": 228.7,
            "actualTimeMin": 480,
            "wearableRecorded": true
          },
          {
            "kcal": 1205.3,
            "actualTimeMin": null
          }
        ]
      },
      "expected": {
        "movement": 340.663
      },
      "why": "Connected path: measured-through-sync (520-228.7=291.3) + model rate for waking minutes since 13:00 (394.9/960 * 120 = 49.4) = 340.7. Freeze would under-count; re-smearing would discard the measurement."
    },
    {
      "id": "neat-subtraction-wearable-only",
      "status": "ratified",
      "kind": "so_far",
      "inputs": {
        "minutesSinceMidnight": 900,
        "rmr": 1908,
        "neatKcal": 394.9,
        "eatenKcal": 1650,
        "wearableConnected": true,
        "syncedToday": true,
        "lastSyncMin": 780,
        "activeEnergyThroughSync": 520,
        "sessions": [
          {
            "kcal": 228.7,
            "actualTimeMin": 480,
            "wearableRecorded": false
          },
          {
            "kcal": 1205.3,
            "actualTimeMin": null
          }
        ]
      },
      "expected": {
        "movement": 569.362
      },
      "why": "The double-count guard is asymmetric: a session the wearable did NOT record is not subtracted from wearable active energy (movement 520+49.4=569.4, not 340.7). Subtracting it would delete real NEAT."
    },
