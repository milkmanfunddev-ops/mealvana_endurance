      "id": "two-time-mark-done",
      "status": "ratified",
      "inputs": {
        "plannedTimeMin": 1050,
        "gesture": "mark_done",
        "nowMin": 900
      },
      "expected": {
        "actualTimeMin": 1050,
        "plannedTimeMin": 1050,
        "displayTimeMin": 1050
