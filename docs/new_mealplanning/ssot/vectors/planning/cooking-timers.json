          "index": 13
        }
      ],
      "why": "secs→sec, hrs→hr."
    },
    {
      "id": "six-hundred-one-hours-parse-error",
      "status": "proposed",
      "fn": "findDurations",
      "inputs": "Timer: 601 hours",
